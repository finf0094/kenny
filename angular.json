{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "pnpm",
    "analytics": false
  },
  "newProjectRoot": "packages",
  "projects": {
    "docs": {
      "projectType": "application",
      "root": "apps/docs",
      "sourceRoot": "apps/docs/src",
      "prefix": "docs",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "apps/docs/src/main.ts",
            "server": "apps/docs/src/main.server.ts",
            "outputMode": "static",
            "outputPath": "dist/docs",
            "tsConfig": "apps/docs/tsconfig.app.json",
            "assets": [{ "glob": "**/*", "input": "apps/docs/public" }],
            "styles": [
              "node_modules/@fontsource-variable/onest/wght.css",
              "node_modules/@fontsource-variable/jetbrains-mono/wght.css",
              "packages/tokens/src/index.css",
              "packages/tokens/src/base.css",
              "apps/docs/src/styles.css"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                { "type": "initial", "maximumWarning": "900kB", "maximumError": "1.5MB" },
                { "type": "anyComponentStyle", "maximumWarning": "12kB", "maximumError": "24kB" }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": { "buildTarget": "docs:build:production" },
            "development": { "buildTarget": "docs:build:development" }
          },
          "defaultConfiguration": "development"
        }
      }
    },
    "playground": {
      "projectType": "application",
      "root": "apps/playground",
      "sourceRoot": "apps/playground/src",
      "prefix": "pg",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "apps/playground/src/main.ts",
            "outputPath": "dist/playground",
            "tsConfig": "apps/playground/tsconfig.app.json",
            "assets": [{ "glob": "**/*", "input": "apps/playground/public" }],
            "styles": [
              "node_modules/@fontsource-variable/onest/wght.css",
              "packages/tokens/src/index.css",
              "packages/tokens/src/base.css",
              "apps/playground/src/styles.css"
            ]
          },
          "configurations": {
            "production": { "outputHashing": "all" },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": { "port": 4300 },
          "configurations": {
            "production": { "buildTarget": "playground:build:production" },
            "development": { "buildTarget": "playground:build:development" }
          },
          "defaultConfiguration": "development"
        }
      }
    },
    "ui": {
      "projectType": "library",
      "root": "packages/ui",
      "sourceRoot": "packages/ui",
      "prefix": "kn",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": { "tsConfig": "packages/ui/tsconfig.lib.prod.json" },
            "development": { "tsConfig": "packages/ui/tsconfig.lib.json" }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "packages/ui/tsconfig.spec.json",
            "include": ["**/*.spec.ts"],
            "setupFiles": ["packages/ui/testing/setup.ts"]
          }
        }
      }
    }
  }
}
