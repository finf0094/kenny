{
  "name": "@kenny/tokens",
  "version": "0.1.0",
  "description": "Дизайн-токены Kenny: цвет, типографика, отступы, тени, стекло и motion в виде CSS custom properties.",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/OWNER/kenny.git", "directory": "packages/tokens" },
