{
  "name": "kenny",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22.12" },
  "scripts": {
    "ng": "ng",
    "gen": "node tools/gen-docs.mjs",
    "start": "pnpm gen && ng serve docs",
    "docs": "pnpm start",
    "playground": "ng serve playground",
    "build": "pnpm build:tokens && pnpm build:ui && pnpm build:docs",
    "build:tokens": "node packages/tokens/build.mjs",
    "build:ui": "ng build ui",
    "build:docs": "pnpm gen && ng build docs",
    "build:playground": "ng build playground",
    "test": "ng test ui --no-watch",
    "test:watch": "ng test ui",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "shots": "node tools/shots.mjs",
    "release": "pnpm build:tokens && pnpm build:ui && pnpm publish -r --filter ./dist/* --access public"
  },
  "dependencies": {
    "@angular/cdk": "^22.2.6",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/platform-server": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@angular/ssr": "^22.2.6",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.6",
    "@angular/cli": "^22.2.6",
    "@angular/compiler-cli": "^22.2.0",
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/onest": "^5.3.1",
    "@testing-library/angular": "^19.6.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/user-event": "^14.6.9",
    "@types/node": "^22.12.0",
    "angular-eslint": "^22.6.0",
    "axe-core": "^4.14.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^30.0.0",
    "ng-packagr": "^22.2.0",
    "prettier": "^3.8.1",
    "puppeteer-core": "^25.17.0",
    "shiki": "^4.6.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.0.0"
  }
}
